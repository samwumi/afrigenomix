generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  role              Role               @default(CUSTOMER)
  isActive          Boolean            @default(true)
  emailVerified     Boolean            @default(false)
  phone             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]
  collectionPartner CollectionPartner?
  customerProfile   CustomerProfile?
  labPartner        LabPartner?
  messages          Message[]
  notifications     Notification[]
  sessions          Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model CustomerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  fullName   String
  country    String
  address    String?
  city       String?
  state      String?
  postalCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cases      Case[]
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Laboratory {
  id             String                    @id @default(uuid())
  name           String
  country        String
  city           String?
  address        String?
  phone          String?
  email          String?
  website        String?
  status         LaboratoryStatus          @default(PENDING_VERIFICATION)
  capabilities   String?
  description    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  cases          Case[]
  labPartners    LabPartner[]
  accreditations LaboratoryAccreditation[]

  @@map("laboratories")
}

model LaboratoryAccreditation {
  id                  String     @id @default(uuid())
  laboratoryId        String
  accreditationType   String
  accreditationBody   String
  accreditationNumber String?
  issuedDate          DateTime?
  expiryDate          DateTime?
  verified            Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  laboratory          Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  @@map("laboratory_accreditations")
}

model LabPartner {
  id           String     @id @default(uuid())
  userId       String     @unique
  laboratoryId String
  fullName     String
  position     String?
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lab_partners")
}

model CollectionPartner {
  id           String               @id @default(uuid())
  userId       String               @unique
  name         String
  country      String
  city         String?
  address      String?
  phone        String?
  email        String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  appointments Appointment[]
  locations    CollectionLocation[]
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("collection_partners")
}

model CollectionLocation {
  id                  String            @id @default(uuid())
  collectionPartnerId String
  name                String
  country             String
  city                String
  address             String
  phone               String?
  operatingHours      String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  appointments        Appointment[]
  collectionPartner   CollectionPartner @relation(fields: [collectionPartnerId], references: [id], onDelete: Cascade)

  @@map("collection_locations")
}

model TestType {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  category       TestCategory
  description    String?
  requirements   String?
  sampleType     String?
  isLegal        Boolean      @default(false)
  chainOfCustody Boolean      @default(false)
  turnaroundDays Int?
  price          Decimal?
  currency       String?      @default("NGN")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cases          Case[]

  @@map("test_types")
}

model Case {
  id           String          @id @default(uuid())
  caseNumber   String          @unique
  customerId   String
  testTypeId   String
  laboratoryId String?
  status       CaseStatus      @default(PENDING)
  purpose      String?
  country      String
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appointments Appointment[]
  timeline     CaseTimeline[]
  laboratory   Laboratory?     @relation(fields: [laboratoryId], references: [id])
  testType     TestType        @relation(fields: [testTypeId], references: [id])
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documents    Document[]
  participants Participant[]
  payments     Payment[]
  quotes       Quote[]
  results      Result[]
  samples      Sample[]

  @@map("cases")
}

model Participant {
  id           String     @id @default(uuid())
  caseId       String
  fullName     String
  relationship String
  dateOfBirth  DateTime?
  country      String?
  city         String?
  phone        String?
  email        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    Document[]
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  samples      Sample[]

  @@map("participants")
}

model Document {
  id              String         @id @default(uuid())
  caseId          String
  participantId   String?
  type            DocumentType
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  status          DocumentStatus @default(UPLOADED)
  uploadedAt      DateTime       @default(now())
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  updatedAt       DateTime       @updatedAt
  participant     Participant?   @relation(fields: [participantId], references: [id])
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Appointment {
  id                   String              @id @default(uuid())
  caseId               String
  collectionPartnerId  String?
  collectionLocationId String?
  appointmentDate      DateTime
  appointmentTime      String
  status               AppointmentStatus   @default(REQUESTED)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  collectionLocation   CollectionLocation? @relation(fields: [collectionLocationId], references: [id])
  collectionPartner    CollectionPartner?  @relation(fields: [collectionPartnerId], references: [id])
  case                 Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Sample {
  id            String       @id @default(uuid())
  caseId        String
  participantId String
  sampleId      String       @unique
  sampleType    String
  status        SampleStatus @default(COLLECTION_SCHEDULED)
  collectedAt   DateTime?
  receivedAt    DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  participant   Participant  @relation(fields: [participantId], references: [id])
  case          Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("samples")
}

model Quote {
  id            String      @id @default(uuid())
  caseId        String
  amount        Decimal
  currency      String      @default("NGN")
  testFee       Decimal?
  collectionFee Decimal?
  courierFee    Decimal?
  otherFees     Decimal?
  status        QuoteStatus @default(DRAFT)
  validUntil    DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  case          Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

model Payment {
  id               String        @id @default(uuid())
  caseId           String
  amount           Decimal
  currency         String        @default("NGN")
  paymentReference String        @unique
  paymentProvider  String?
  status           PaymentStatus @default(PENDING)
  transactionDate  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  case             Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Result {
  id         String       @id @default(uuid())
  caseId     String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  status     ResultStatus @default(PENDING)
  uploadedAt DateTime     @default(now())
  releasedAt DateTime?
  releasedBy String?
  updatedAt  DateTime     @updatedAt
  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("results")
}

model CaseTimeline {
  id          String   @id @default(uuid())
  caseId      String
  event       String
  description String?
  performedBy String?
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_timeline")
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  subject   String
  message   String
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Message {
  id        String    @id @default(uuid())
  userId    String
  subject   String
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ContentAuthor {
  id        String    @id @default(uuid())
  name      String
  title     String?
  bio       String?
  avatar    String?
  email     String?
  social    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@map("content_authors")
}

model Article {
  id              String          @id @default(uuid())
  title           String
  slug            String          @unique
  content         String
  excerpt         String?
  category        ArticleCategory
  authorId        String?
  featuredImage   String?
  status          ArticleStatus   @default(DRAFT)
  isFeatured      Boolean         @default(false)
  viewCount       Int             @default(0)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tags            ArticleTag[]
  author          ContentAuthor?  @relation(fields: [authorId], references: [id])

  @@map("articles")
}

model ArticleTag {
  id        String   @id @default(uuid())
  articleId String
  tag       String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_tags")
}

model AdvocacyCampaign {
  id                String              @id @default(uuid())
  title             String
  slug              String              @unique
  description       String
  longDescription   String?
  goal              String
  targetCountries   String
  signatureGoal     Int?
  currentSignatures Int                 @default(0)
  bannerImage       String?
  videoUrl          String?
  status            CampaignStatus      @default(PLANNING)
  priority          Int                 @default(0)
  launchDate        DateTime?
  targetDate        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  milestones        CampaignMilestone[]
  updates           CampaignUpdate[]

  @@map("advocacy_campaigns")
}

model CampaignMilestone {
  id          String           @id @default(uuid())
  campaignId  String
  title       String
  description String?
  isCompleted Boolean          @default(false)
  completedAt DateTime?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  campaign    AdvocacyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_milestones")
}

model CampaignUpdate {
  id          String           @id @default(uuid())
  campaignId  String
  title       String
  content     String
  image       String?
  publishedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  campaign    AdvocacyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_updates")
}

model Newsletter {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

model FAQ {
  id        String   @id @default(uuid())
  category  String
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resourceType  String?
  resourceId    String?
  previousValue String?
  newValue      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum Role {
  CUSTOMER
  COLLECTION_PARTNER
  LAB_PARTNER
  ADMIN
  SUPER_ADMIN
}

enum LaboratoryStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum TestCategory {
  PATERNITY
  MATERNITY
  SIBLING
  GRANDPARENT
  IMMIGRATION
  LEGAL
  PRENATAL
  GENETIC
  OTHER
}

enum CaseStatus {
  PENDING
  DOCUMENTS_SUBMITTED
  DOCUMENTS_VERIFIED
  AWAITING_COLLECTION
  COLLECTION_SCHEDULED
  COLLECTION_COMPLETED
  SAMPLE_IN_TRANSIT
  SAMPLE_RECEIVED
  TESTING_IN_PROGRESS
  QUALITY_REVIEW
  RESULT_READY
  RESULT_RELEASED
  COMPLETED
  CANCELLED
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  BIRTH_CERTIFICATE
  IMMIGRATION_DOCUMENT
  COLLECTION_FORM
  CONSENT_FORM
  OTHER
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SampleStatus {
  COLLECTION_SCHEDULED
  COLLECTED
  PREPARED_FOR_SHIPMENT
  IN_TRANSIT
  RECEIVED_BY_LAB
  ACCEPTED
  REJECTED
  TESTING
  COMPLETED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ResultStatus {
  PENDING
  PROCESSING
  QUALITY_REVIEW
  READY
  RELEASED
  SUPERSEDED
}

enum NotificationType {
  EMAIL
  SMS
  IN_APP
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleCategory {
  DNA_EDUCATION
  PATERNITY_TESTING
  IMMIGRATION_DNA
  LEGAL_DNA
  ADVOCACY
  PATERNITY_FRAUD
  LEGISLATION
  CASE_STUDIES
  SCIENCE
  NEWS
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

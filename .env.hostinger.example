# Afrigenomix Environment Variables for Hostinger
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE (MySQL on Hostinger)
# ============================================
# Replace YOUR_MYSQL_PASSWORD with the password you set for the MySQL user
DATABASE_URL="mysql://u215495167_afrigenomix:YOUR_MYSQL_PASSWORD@localhost:3306/u215495167_afrigenomix"

# ============================================
# AUTHENTICATION SECRETS
# ============================================
# Generate these secrets using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Run the command twice to get two different secrets

JWT_SECRET="REPLACE_WITH_32_CHAR_HEX_STRING"
NEXTAUTH_SECRET="REPLACE_WITH_ANOTHER_32_CHAR_HEX_STRING"

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://afrigenomix.com"

# ============================================
# FILE UPLOADS
# ============================================
# Adjust the path based on your Hostinger username
UPLOAD_DIR="/home/u215495167/uploads"
MAX_FILE_SIZE="10485760"

# ============================================
# EMAIL CONFIGURATION (Hostinger SMTP)
# ============================================
# Create an email account in Hostinger: noreply@afrigenomix.com
# Then add the password here
EMAIL_FROM="noreply@afrigenomix.com"
EMAIL_HOST="smtp.hostinger.com"
EMAIL_PORT="465"
EMAIL_USER="noreply@afrigenomix.com"
EMAIL_PASSWORD="YOUR_EMAIL_PASSWORD_HERE"
EMAIL_SECURE="true"

# ============================================
# PAYMENT INTEGRATION (Optional - Paystack)
# ============================================
# Get these from https://dashboard.paystack.com/#/settings/developers
# Start with test keys, then switch to live keys when ready
PAYSTACK_SECRET_KEY="sk_test_YOUR_SECRET_KEY"
PAYSTACK_PUBLIC_KEY="pk_test_YOUR_PUBLIC_KEY"

# For production, use live keys:
# PAYSTACK_SECRET_KEY="sk_live_YOUR_LIVE_SECRET_KEY"
# PAYSTACK_PUBLIC_KEY="pk_live_YOUR_LIVE_PUBLIC_KEY"

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.hostinger.example .env
# 2. Replace YOUR_MYSQL_PASSWORD with your actual MySQL password
# 3. Generate JWT_SECRET and NEXTAUTH_SECRET (see commands above)
# 4. Create email account in Hostinger and add password
# 5. (Optional) Set up Paystack account and add API keys
# 6. Save the file
# 7. Run: npx prisma db push
# 8. Run: npx prisma db seed
# 9. Run: npm run build
# 10. Run: pm2 start npm --name "afrigenomix" -- start
